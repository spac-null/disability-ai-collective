# Persona state — runtime, updated per article, not versioned
automation/persona_state/

# Social post coordination state (pending_social / bsky_uri markers written by
# the orchestrator, read by publish_best.py on promotion) — local runtime
# state, not versioned. Same category as persona_state/ above.
_social/
automation/bsky_engage_seen.json

# Orchestrator lock file
.orchestrator.lock

# Claude Code worktree/session metadata
.claude/worktrees/

# Reader Lab Worker — local dev state and secrets, never committed
reader-lab-worker/.wrangler/
reader-lab-worker/.dev.vars
reader-lab-worker/node_modules/
reader-lab-worker/.pilot-invites
reader-lab-worker/.export-token

# Generation-time citation-review sidecars (_reviews/<slug>-review.md), written by
# automation/orchestrator/review.py. These are internal artifacts: never a Jekyll
# collection, never rendered, /reviews/... 404s. They restate claims as they stood at
# generation time, including claims later found false, so they do not belong in the
# public repo. The current snapshot was moved to private storage on 2026-08-24, verified
# file by file against sha256 before removal. The writer is unaffected — it still mkdirs
# and writes locally; this only keeps new sidecars from re-entering git.
_reviews/

# Internal persona-soul / persona-wound seed records are private evidence.
# Preserved under /srv/data/cripminds-lc1/ — never re-add to this repo.
.claude/persona-souls*
PersonaSouls*
